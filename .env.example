# =============================================================================
# Riggs Bid Log
# =============================================================================

APP_NAME=Riggs Bid Log
APP_VERSION=0.1.0
APP_ENV=development


# =============================================================================
# Authentication
# =============================================================================

# Production:
#   AUTH_MODE=entra
#
# Local BarronLink:
#   AUTH_MODE=dev
#   DEV_AUTH_ENTRA_OBJECT_ID=<Entra Object ID GUID>
#
# AUTH_MODE=dev is blocked on Cloud Run / production.

AUTH_MODE=entra
DEV_AUTH_ENTRA_OBJECT_ID=


# =============================================================================
# Microsoft Entra
# =============================================================================

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=


# =============================================================================
# Session
# =============================================================================

SESSION_SECRET=

SESSION_COOKIE_SECURE=false

SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1200


# =============================================================================
# Riggs Data API
# =============================================================================

DATA_API_BASE_URL=https://api.riggsdata.net

DATA_API_CLIENT_TOKEN=

DATA_API_CF_ACCESS_CLIENT_ID=
DATA_API_CF_ACCESS_CLIENT_SECRET=

DATA_API_CONNECT_TIMEOUT_SECONDS=3
DATA_API_READ_TIMEOUT_SECONDS=5
